<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NovaGet.Core</RootNamespace>
    <AssemblyName>NovaGet.Core</AssemblyName>
    <!-- Core stays UI-free and cross-platform so the engine can be tested anywhere.
         Windows-only calls are guarded with OperatingSystem.IsWindows(). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="FluentFTP" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NovaGet.Core.Tests" />
  </ItemGroup>

</Project>
