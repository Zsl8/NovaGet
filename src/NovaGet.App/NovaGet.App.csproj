<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.17763 = Windows 10 1809, the minimum supported OS; also enables toast notifications. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>NovaGet</AssemblyName>
    <RootNamespace>NovaGet.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\ico\novaget.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>NovaGet Download Manager</AssemblyTitle>
    <Description>NovaGet Download Manager</Description>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- LibraryImport (source-generated P/Invoke) needs unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main owns startup (single instance, host), so App.xaml is a plain page. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icons\ico\novaget.ico" Link="Assets\novaget.ico" />
    <Resource Include="..\..\assets\icons\png\novaget-*.png" Link="Assets\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaGet.Core\NovaGet.Core.csproj" />
    <ProjectReference Include="..\NovaGet.Data\NovaGet.Data.csproj" />
  </ItemGroup>

</Project>
