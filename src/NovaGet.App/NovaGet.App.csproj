<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection version (toast notifications need 10.0.18362+); the app still runs on
         Windows 10 1809 (10.0.17763), the minimum supported OS. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>NovaGet</AssemblyName>
    <RootNamespace>NovaGet.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\ico\novaget.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>NovaGet Download Manager</AssemblyTitle>
    <Description>NovaGet Download Manager</Description>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main owns startup (single instance, host), so App.xaml is a plain page. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icons\ico\*.ico" Link="Assets\%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\icons\png\*.png" Link="Assets\Icons\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NovaGet.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaGet.Core\NovaGet.Core.csproj" />
    <ProjectReference Include="..\NovaGet.Data\NovaGet.Data.csproj" />
  </ItemGroup>

</Project>
