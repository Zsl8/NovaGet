<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.CategoryDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <StackPanel Margin="16" Width="440">
    <Label Content="{l:Loc CategoryDialog_Name}" Target="{Binding ElementName=NameBox}" Padding="0" />
    <TextBox x:Name="NameBox" Margin="0,4,0,0" Height="23" VerticalContentAlignment="Center" />
    <Label Content="{l:Loc CategoryDialog_Extensions}" Target="{Binding ElementName=ExtensionsBox}" Padding="0" Margin="0,12,0,0" />
    <TextBox x:Name="ExtensionsBox" Margin="0,4,0,0" Height="48" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    <Label Content="{l:Loc CategoryDialog_Folder}" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,12,0,0" />
    <DockPanel Margin="0,4,0,0">
      <Button DockPanel.Dock="Right" Content="{l:Loc Common_Browse}" Width="28" Margin="6,0,0,0" Click="OnBrowse" />
      <TextBox x:Name="FolderBox" Height="23" VerticalContentAlignment="Center" />
    </DockPanel>
    <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,8,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
