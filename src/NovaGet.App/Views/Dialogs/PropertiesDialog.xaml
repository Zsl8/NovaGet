<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.PropertiesDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="{l:Loc Props_Title}">
  <StackPanel Margin="16" Width="540">
    <DockPanel>
      <Image x:Name="FileIcon" Width="32" Height="32" Margin="0,0,12,0" />
      <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <Separator Margin="0,10" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="{l:Loc Props_FileType}" Margin="0,3,12,3" />
      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TypeText" Margin="0,3" />
      <TextBlock Grid.Row="1" Text="{l:Loc Props_Status}" Margin="0,3,12,3" />
      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StatusText" Margin="0,3" TextWrapping="Wrap" />
      <TextBlock Grid.Row="2" Text="{l:Loc Props_Size}" Margin="0,3,12,3" />
      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SizeText" Margin="0,3" />

      <Label Grid.Row="3" Content="{l:Loc Props_SaveTo}" Target="{Binding ElementName=SaveToBox}" Padding="0,0,12,0" VerticalAlignment="Center" Margin="0,4,0,0" />
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="SaveToBox" Height="23" VerticalContentAlignment="Center" Margin="0,4,0,0" />
      <Button Grid.Row="3" Grid.Column="2" Content="{l:Loc Common_Browse}" Width="28" Margin="6,4,0,0" Click="OnBrowse" />

      <Label Grid.Row="4" Content="{l:Loc Props_Address}" Target="{Binding ElementName=AddressBox}" Padding="0,0,12,0" VerticalAlignment="Center" Margin="0,4,0,0" />
      <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AddressBox" Height="23" VerticalContentAlignment="Center" Margin="0,4,0,0" />
      <Label Grid.Row="5" Content="{l:Loc Props_Referrer}" Target="{Binding ElementName=ReferrerBox}" Padding="0,0,12,0" VerticalAlignment="Center" Margin="0,4,0,0" />
      <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ReferrerBox" Height="23" VerticalContentAlignment="Center" Margin="0,4,0,0" />
      <Label Grid.Row="6" Content="{l:Loc Props_Description}" Target="{Binding ElementName=DescriptionBox}" Padding="0,0,12,0" VerticalAlignment="Center" Margin="0,4,0,0" />
      <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="DescriptionBox" Height="23" VerticalContentAlignment="Center" Margin="0,4,0,0" />

      <Label Grid.Row="7" Content="{l:Loc Props_Login}" Target="{Binding ElementName=LoginBox}" Padding="0,0,12,0" VerticalAlignment="Center" Margin="0,4,0,0" />
      <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LoginBox" Height="23" VerticalContentAlignment="Center" />
        <Label Grid.Column="1" Content="{l:Loc Props_Password}" Target="{Binding ElementName=PasswordBox}" Padding="10,0,8,0" VerticalAlignment="Center" />
        <PasswordBox Grid.Column="2" x:Name="PasswordBox" Height="23" VerticalContentAlignment="Center" />
      </Grid>

      <TextBlock Grid.Row="8" Text="{l:Loc Props_Added}" Margin="0,6,12,3" />
      <TextBlock Grid.Row="8" Grid.Column="1" x:Name="AddedText" Margin="0,6,0,3" />
      <TextBlock Grid.Row="9" Text="{l:Loc Props_Completed}" Margin="0,3,12,3" />
      <TextBlock Grid.Row="9" Grid.Column="1" x:Name="CompletedText" Margin="0,3" />

      <Label Grid.Row="10" Content="{l:Loc Props_Connections}" Target="{Binding ElementName=ConnectionsBox}" Padding="0,0,12,0" VerticalAlignment="Center" Margin="0,4,0,0" />
      <ComboBox Grid.Row="10" Grid.Column="1" x:Name="ConnectionsBox" Width="110" HorizontalAlignment="Left" Margin="0,4,0,0" />

      <TextBlock Grid.Row="11" Text="{l:Loc Props_Checksum}" Margin="0,8,12,0" VerticalAlignment="Center" />
      <DockPanel Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
        <ComboBox x:Name="AlgorithmBox" DockPanel.Dock="Left" Width="84" AutomationProperties.Name="{l:Loc Props_Checksum}" />
        <Button x:Name="VerifyButton" DockPanel.Dock="Right" Content="{l:Loc Props_Verify}" MinWidth="70" Margin="6,0,0,0" Click="OnVerify" />
        <TextBox x:Name="ExpectedBox" Height="23" VerticalContentAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas"
                 TextChanged="OnExpectedChanged" AutomationProperties.Name="{l:Loc Props_Checksum}" />
      </DockPanel>
      <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ChecksumResult" Margin="0,6,0,0" TextWrapping="Wrap" />
    </Grid>
    <CheckBox x:Name="IgnoreCertBox" Content="{l:Loc Props_IgnoreCert}" Margin="0,10,0,0" />
    <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="OpenButton" DockPanel.Dock="Left" Content="{l:Loc Complete_Open}" MinWidth="70" Click="OnOpen" />
      <Button x:Name="OpenWithButton" DockPanel.Dock="Left" Content="{l:Loc Complete_OpenWith}" MinWidth="80" Margin="6,0,0,0" Click="OnOpenWith" />
      <Button DockPanel.Dock="Left" Content="{l:Loc Complete_OpenFolder}" MinWidth="80" Margin="6,0,0,0" Click="OnOpenFolder" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
    </DockPanel>
  </StackPanel>
</v:DialogWindow>
