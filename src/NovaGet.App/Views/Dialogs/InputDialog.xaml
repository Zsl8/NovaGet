<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.InputDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                FocusManager.FocusedElement="{Binding ElementName=ValueBox}">
  <StackPanel Margin="16" Width="340">
    <Label x:Name="PromptLabel" Target="{Binding ElementName=ValueBox}" Padding="0" />
    <TextBox x:Name="ValueBox" Margin="0,6,0,0" Height="23" VerticalContentAlignment="Center" />
    <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
