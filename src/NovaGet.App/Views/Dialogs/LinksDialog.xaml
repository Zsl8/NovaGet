<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.LinksDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                xmlns:c="clr-namespace:NovaGet.App.Converters"
                Title="{l:Loc Links_Title}" SizeToContent="Manual" Width="760" Height="540" MinWidth="560" MinHeight="400"
                ResizeMode="CanResizeWithGrip">
  <v:DialogWindow.Resources>
    <c:InverseBoolConverter x:Key="Not" />
  </v:DialogWindow.Resources>
  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Request.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

    <!-- Filters -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Label Content="{l:Loc Links_Filter}" Target="{Binding ElementName=FilterBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Links_SelectNone}" Padding="8,1" Margin="6,0,0,0" Command="{Binding SelectNoneCommand}" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Links_SelectAll}" Padding="8,1" Margin="6,0,0,0" Command="{Binding SelectAllCommand}" />
      <TextBox x:Name="FilterBox" Height="23" VerticalContentAlignment="Center" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
    </DockPanel>
    <ScrollViewer DockPanel.Dock="Top" MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6" Focusable="False">
      <ItemsControl ItemsSource="{Binding Extensions}" Focusable="False" AutomationProperties.Name="{l:Loc Links_Types}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2,14,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Destination and buttons -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionText}" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
      <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="{l:Loc FileInfo_DownloadLater}" MinWidth="110" Margin="8,0,0,0" Click="OnDownloadLater" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Links_Download}" MinWidth="90" IsDefault="True" Click="OnDownload" />
    </DockPanel>
    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label Content="{l:Loc FileInfo_Category}" Target="{Binding ElementName=CategoryBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
      <ComboBox x:Name="CategoryBox" Grid.Column="1" Height="23" ItemsSource="{Binding Categories}" DisplayMemberPath="Title" SelectedValuePath="Id"
                SelectedValue="{Binding CategoryId}" />
      <Label Grid.Column="2" Content="{l:Loc FileInfo_SaveAs}" Target="{Binding ElementName=FolderBox}" Padding="12,0,8,0" VerticalAlignment="Center" />
      <TextBox x:Name="FolderBox" Grid.Column="3" Height="23" VerticalContentAlignment="Center" Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}"
               IsEnabled="{Binding IsAutomaticCategory, Converter={StaticResource Not}}" />
      <Button Grid.Column="4" Content="…" Width="28" Margin="6,0,0,0" Click="OnBrowse" IsEnabled="{Binding IsAutomaticCategory, Converter={StaticResource Not}}"
              AutomationProperties.Name="{l:Loc Common_Browse}" />
    </Grid>

    <!-- Links -->
    <ListView x:Name="LinksList" ItemsSource="{Binding View}" AutomationProperties.Name="{l:Loc Links_Title}" KeyDown="OnListKeyDown">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="34">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding FileName}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="{l:Loc Col_FileName}" DisplayMemberBinding="{Binding FileName}" Width="200" />
          <GridViewColumn Header="{l:Loc Links_Type}" DisplayMemberBinding="{Binding Type}" Width="60" />
          <GridViewColumn Header="{l:Loc Links_Url}" DisplayMemberBinding="{Binding Address}" Width="280" />
          <GridViewColumn Header="{l:Loc Col_Description}" DisplayMemberBinding="{Binding Description}" Width="150" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</v:DialogWindow>
