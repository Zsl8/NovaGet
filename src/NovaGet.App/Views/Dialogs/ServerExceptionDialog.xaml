<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.ServerExceptionDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="{l:Loc ServerExceptionDialog_Title}" FocusManager.FocusedElement="{Binding ElementName=HostBox}">
  <StackPanel Margin="16" Width="360">
    <Label Content="{l:Loc ServerExceptionDialog_Host}" Target="{Binding ElementName=HostBox}" Padding="0,0,0,4" />
    <TextBox FlowDirection="LeftToRight" x:Name="HostBox" Height="23" VerticalContentAlignment="Center" />
    <TextBlock Text="{l:Loc ServerExceptionDialog_HostNote}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <DockPanel Margin="0,10,0,0">
      <Label Content="{l:Loc Options_MaxConnectionsColumn}" Target="{Binding ElementName=CountBox}" Padding="0,0,10,0" VerticalAlignment="Center" />
      <ComboBox x:Name="CountBox" Width="80" HorizontalAlignment="Left" />
    </DockPanel>
    <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
