<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.DuplicateDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="{l:Loc Duplicate_Title}">
  <StackPanel Margin="16" Width="420">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Margin="0,14,0,0">
      <Button Content="{l:Loc Duplicate_AddNumbered}" HorizontalContentAlignment="Left" Padding="10,4" Click="OnNumbered" IsDefault="True" />
      <Button Content="{l:Loc Duplicate_Overwrite}" HorizontalContentAlignment="Left" Padding="10,4" Margin="0,6,0,0" Click="OnOverwrite" />
      <Button Content="{l:Loc Duplicate_ShowExisting}" HorizontalContentAlignment="Left" Padding="10,4" Margin="0,6,0,0" Click="OnShowExisting" />
    </StackPanel>
    <Button Content="{l:Loc Common_Cancel}" MinWidth="80" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True" />
  </StackPanel>
</v:DialogWindow>
