<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.ContextMenuItemsDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="{l:Loc ContextMenuDialog_Title}">
  <StackPanel Margin="16" MinWidth="320">
    <TextBlock Text="{l:Loc ContextMenuDialog_Intro}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left" />
    <CheckBox x:Name="LinkBox" Content="{l:Loc ContextMenu_DownloadWith}" Margin="0,3" />
    <CheckBox x:Name="AllLinksBox" Content="{l:Loc ContextMenu_DownloadAll}" Margin="0,3" />
    <CheckBox x:Name="VideoBox" Content="{l:Loc ContextMenu_DownloadVideo}" Margin="0,3" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
