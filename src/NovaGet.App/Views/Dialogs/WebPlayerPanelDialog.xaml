<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.WebPlayerPanelDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="{l:Loc WebPanelDialog_Title}">
  <StackPanel Margin="16" Width="400">
    <CheckBox x:Name="ShowBox" Content="{l:Loc WebPanel_Show}" Margin="0,3" />
    <StackPanel IsEnabled="{Binding IsChecked, ElementName=ShowBox}" Margin="20,0,0,0">
      <CheckBox x:Name="PopupBox" Content="{l:Loc WebPanel_Popups}" Margin="0,3" />
      <CheckBox x:Name="HoverBox" Content="{l:Loc WebPanel_HoverOnly}" Margin="0,3" />
      <DockPanel Margin="0,6,0,0">
        <Label Content="{l:Loc WebPanel_Position}" Target="{Binding ElementName=PositionBox}" Padding="0,0,10,0" VerticalAlignment="Center" />
        <ComboBox x:Name="PositionBox" Width="160" HorizontalAlignment="Left" DisplayMemberPath="Text" SelectedValuePath="Value" />
      </DockPanel>
    </StackPanel>
    <Label Content="{l:Loc WebPanel_Exceptions}" Target="{Binding ElementName=ExceptionsBox}" Padding="0,12,0,4" />
    <TextBox x:Name="ExceptionsBox" Height="110" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    <TextBlock Text="{l:Loc WebPanel_ExceptionsNote}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
