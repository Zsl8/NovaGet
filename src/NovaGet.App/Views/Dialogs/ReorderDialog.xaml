<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.ReorderDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:d="clr-namespace:NovaGet.App.Views.Dialogs"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                SizeToContent="Manual" Width="380" Height="420" ResizeMode="CanResizeWithGrip">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="IntroText" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8" />
    <ListBox x:Name="EntryList" Grid.Row="1" AutomationProperties.Name="{Binding Text, ElementName=IntroText}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type d:ReorderEntry}">
          <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
              <TextBlock Text="{Binding Label}" />
            </StackPanel>
          </CheckBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
      <Button Content="{l:Loc Common_MoveUp}" MinWidth="90" Click="OnUp" />
      <Button Content="{l:Loc Common_MoveDown}" MinWidth="90" Margin="0,6,0,0" Click="OnDown" />
      <Button Content="{l:Loc Common_Reset}" MinWidth="90" Margin="0,18,0,0" Click="OnReset" />
    </StackPanel>
    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</v:DialogWindow>
