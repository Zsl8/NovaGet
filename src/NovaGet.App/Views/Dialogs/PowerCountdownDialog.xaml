<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.PowerCountdownDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="NovaGet" Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="18" Width="380">
    <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" />
    <ProgressBar x:Name="CountdownBar" Height="8" Margin="0,12,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:Loc Power_Now}" MinWidth="100" Click="OnNow" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
