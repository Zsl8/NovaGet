<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.TellAFriendDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="{l:Loc TellFriend_Title}">
  <StackPanel Margin="16" Width="420">
    <TextBlock Text="{l:Loc TellFriend_Intro}" />
    <TextBox x:Name="MessageBox" Margin="0,8,0,0" Height="110" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
    <TextBlock x:Name="CopiedText" Margin="0,6,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{l:Loc TellFriend_Copy}" MinWidth="120" IsDefault="True" Click="OnCopy" />
      <Button Content="{l:Loc Common_Close}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</v:DialogWindow>
