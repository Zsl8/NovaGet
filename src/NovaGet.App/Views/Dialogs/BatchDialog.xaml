<v:DialogWindow x:Class="NovaGet.App.Views.Dialogs.BatchDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:NovaGet.App.Views"
                xmlns:l="clr-namespace:NovaGet.App.Localization"
                Title="{l:Loc Batch_Title}" FocusManager.FocusedElement="{Binding ElementName=AddressBox}">
  <v:DialogWindow.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </v:DialogWindow.Resources>
  <Grid Margin="14" Width="520">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Label Content="{l:Loc Batch_Address}" Target="{Binding ElementName=AddressBox}" VerticalAlignment="Center" Padding="0,0,8,0" />
    <TextBox x:Name="AddressBox" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
             AutomationProperties.Name="{l:Loc Batch_Address}" />
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:Loc Batch_Hint}" Margin="0,3,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

    <TextBlock Grid.Row="2" Text="{l:Loc Batch_ReplaceWith}" Margin="0,10,8,0" VerticalAlignment="Center" />
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
      <RadioButton Content="{l:Loc Batch_Numbers}" IsChecked="{Binding IsNumbers}" GroupName="Mode" />
      <RadioButton Content="{l:Loc Batch_Letters}" IsChecked="{Binding IsLetters}" GroupName="Mode" Margin="16,0,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
      <Label Content="{l:Loc Batch_From}" Target="{Binding ElementName=FromBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
      <TextBox x:Name="FromBox" Width="70" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
      <Label Content="{l:Loc Batch_To}" Target="{Binding ElementName=ToBox}" Padding="14,0,6,0" VerticalAlignment="Center" />
      <TextBox x:Name="ToBox" Width="70" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
      <Label Content="{l:Loc Batch_WildcardSize}" Target="{Binding ElementName=SizeBox}" Padding="14,0,6,0" VerticalAlignment="Center"
             IsEnabled="{Binding IsSizeEnabled}" />
      <TextBox x:Name="SizeBox" Width="36" Text="{Binding WildcardSize, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSizeEnabled}"
               HorizontalContentAlignment="Right" FlowDirection="LeftToRight" />
      <StackPanel IsEnabled="{Binding IsSizeEnabled}">
        <RepeatButton Content="▲" FontSize="7" Width="16" Height="11" Padding="0" Command="{Binding IncreaseSizeCommand}"
                      AutomationProperties.Name="{l:Loc Batch_Increase}" />
        <RepeatButton Content="▼" FontSize="7" Width="16" Height="11" Padding="0" Command="{Binding DecreaseSizeCommand}"
                      AutomationProperties.Name="{l:Loc Batch_Decrease}" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="4" Text="{l:Loc Batch_FirstFile}" Margin="0,12,8,0" />
    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FirstFile}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FirstFile}" />
    <TextBlock Grid.Row="5" Text="{l:Loc Batch_LastFile}" Margin="0,4,8,0" />
    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastFile}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastFile}" />
    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap">
      <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
      <Run Text="{Binding Error, Mode=OneWay}" Foreground="Firebrick" />
    </TextBlock>

    <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <CheckBox x:Name="AuthBox" Content="{l:Loc Batch_UseAuth}" IsChecked="{Binding UseAuthorization}" />
      <StackPanel Orientation="Horizontal" Margin="20,6,0,0" IsEnabled="{Binding UseAuthorization}">
        <Label Content="{l:Loc Batch_Login}" Target="{Binding ElementName=UserBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
        <TextBox x:Name="UserBox" Width="150" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
        <Label Content="{l:Loc Batch_Password}" Target="{Binding ElementName=PasswordBox}" Padding="14,0,6,0" VerticalAlignment="Center" />
        <PasswordBox x:Name="PasswordBox" Width="150" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{l:Loc Common_OK}" MinWidth="80" IsDefault="True" Click="OnOk" />
      <Button Content="{l:Loc Common_Cancel}" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</v:DialogWindow>
