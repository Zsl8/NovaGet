<Window x:Class="NovaGet.App.Views.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NovaGet.App.Localization"
        xmlns:c="clr-namespace:NovaGet.App.Converters"
        xmlns:s="clr-namespace:NovaGet.App.ViewModels.Scheduler"
        Title="{l:Loc Scheduler_Title}" Width="720" Height="520" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <c:CollapsedWhenTrueConverter x:Key="Hidden" />
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="23" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="70" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style x:Key="BarButton" TargetType="Button">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="10">
    <!-- Bottom buttons -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="{l:Loc Scheduler_StartNow}" Style="{StaticResource BarButton}" Command="{Binding StartNowCommand}" />
      <Button DockPanel.Dock="Left" Content="{l:Loc Scheduler_Stop}" Style="{StaticResource BarButton}" Margin="6,0,0,0" Command="{Binding StopCommand}" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Scheduler_Apply}" Style="{StaticResource BarButton}" Margin="6,0,0,0" Command="{Binding ApplyChangesCommand}" />
      <Button DockPanel.Dock="Right" Content="{l:Loc Common_Close}" Style="{StaticResource BarButton}" IsCancel="True" Click="OnClose" />
    </DockPanel>

    <!-- Queues -->
    <DockPanel DockPanel.Dock="Left" Width="190" Margin="0,0,10,0">
      <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
        <Button Content="{l:Loc Scheduler_NewQueue}" Margin="0,0,3,0" Padding="4,2" Command="{Binding NewQueueCommand}" />
        <Button Content="{l:Loc Common_Delete}" Margin="3,0,0,0" Padding="4,2" Command="{Binding DeleteQueueCommand}" />
      </UniformGrid>
      <ListBox x:Name="QueueList" ItemsSource="{Binding Queues}" SelectedItem="{Binding SelectedQueue}" AutomationProperties.Name="{l:Loc Tree_Queues}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type s:QueueEditViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
              <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <TextBlock Text=" ▶" Foreground="ForestGreen" VerticalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}"
                         ToolTip="{l:Loc Scheduler_Running}" />
              <TextBlock Text=" *" VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource Visible}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Selected queue -->
    <TabControl x:Name="Tabs" DataContext="{Binding SelectedQueue}">
      <TabItem x:Name="ScheduleTab" Header="{l:Loc Scheduler_TabSchedule}"
               Visibility="{Binding IsSyncQueue, Converter={StaticResource Hidden}, FallbackValue=Visible}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8" Focusable="False">
          <StackPanel>
            <DockPanel Visibility="{Binding CanRename, Converter={StaticResource Visible}}" Margin="0,0,0,4">
              <Label Content="{l:Loc Scheduler_QueueName}" Target="{Binding ElementName=NameBox}" Padding="0,0,10,0" VerticalAlignment="Center" />
              <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            </DockPanel>
            <DockPanel>
              <RadioButton Content="{l:Loc Scheduler_OneTime}" IsChecked="{Binding IsOneTime}" GroupName="Mode" VerticalAlignment="Center" />
              <DatePicker SelectedDate="{Binding OneTimeDate}" Margin="10,0,0,0" Width="140" HorizontalAlignment="Left" IsEnabled="{Binding IsOneTime}"
                          AutomationProperties.Name="{l:Loc Scheduler_OneTime}" />
            </DockPanel>
            <RadioButton Content="{l:Loc Scheduler_Daily}" IsChecked="{Binding IsDaily}" GroupName="Mode" />
            <StackPanel Margin="20,0,0,0" IsEnabled="{Binding IsDaily}">
              <CheckBox Content="{l:Loc Scheduler_EveryDay}" IsChecked="{Binding EveryDay}" />
              <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type s:DayOption}">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3,12,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <WrapPanel Margin="0,6,0,0">
              <CheckBox x:Name="StartCheck" Content="{l:Loc Scheduler_StartAt}" IsChecked="{Binding StartEnabled}" VerticalAlignment="Center" />
              <TextBox Style="{StaticResource TimeBox}" Margin="8,0,24,0" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsChecked, ElementName=StartCheck}" AutomationProperties.Name="{l:Loc Scheduler_StartAt}" />
              <CheckBox x:Name="StopCheck" Content="{l:Loc Scheduler_StopAt}" IsChecked="{Binding StopEnabled}" VerticalAlignment="Center" />
              <TextBox Style="{StaticResource TimeBox}" Margin="8,0,0,0" Text="{Binding StopTime, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsChecked, ElementName=StopCheck}" AutomationProperties.Name="{l:Loc Scheduler_StopAt}" />
            </WrapPanel>
            <CheckBox Content="{l:Loc Scheduler_StartOnStartup}" IsChecked="{Binding StartOnAppStartup}" Margin="0,6,0,3" />
            <DockPanel>
              <Label Content="{l:Loc Scheduler_Retries}" Target="{Binding ElementName=RetriesBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
              <TextBox x:Name="RetriesBox" Style="{StaticResource NumberBox}" HorizontalAlignment="Left" Text="{Binding RetriesPerFile, ValidatesOnExceptions=True}" />
            </DockPanel>
            <GroupBox Header="{l:Loc Scheduler_AfterDone}">
              <StackPanel>
                <DockPanel>
                  <CheckBox x:Name="OpenFileCheck" Content="{l:Loc Scheduler_OpenFile}" IsChecked="{Binding OpenFileWhenDone}" VerticalAlignment="Center" />
                  <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="6,0,0,0" Click="OnBrowseOpenFile" IsEnabled="{Binding IsChecked, ElementName=OpenFileCheck}"
                          AutomationProperties.Name="{l:Loc Common_Browse}" />
                  <TextBox Text="{Binding OpenFilePath}" Margin="8,0,0,0" IsEnabled="{Binding IsChecked, ElementName=OpenFileCheck}"
                           AutomationProperties.Name="{l:Loc Scheduler_OpenFile}" />
                </DockPanel>
                <CheckBox Content="{l:Loc Progress_HangUp}" IsChecked="{Binding HangUpWhenDone}" />
                <CheckBox Content="{l:Loc Progress_ExitWhenDone}" IsChecked="{Binding ExitWhenDone}" />
                <WrapPanel>
                  <CheckBox x:Name="TurnOffCheck" Content="{l:Loc Progress_TurnOff}" IsChecked="{Binding TurnOffWhenDone}" VerticalAlignment="Center" />
                  <ComboBox Width="130" Margin="8,0,0,0" ItemsSource="{x:Static s:QueueEditViewModel.PowerActions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                            SelectedValue="{Binding PowerAction}" IsEnabled="{Binding IsChecked, ElementName=TurnOffCheck}"
                            AutomationProperties.Name="{l:Loc Progress_TurnOff}" />
                </WrapPanel>
                <CheckBox Content="{l:Loc Progress_Force}" IsChecked="{Binding ForceProcesses}" Margin="20,3,0,3"
                          IsEnabled="{Binding IsChecked, ElementName=TurnOffCheck}" />
              </StackPanel>
            </GroupBox>
            <CheckBox Content="{l:Loc Scheduler_Wake}" IsChecked="{Binding WakeComputer}" Margin="0,8,0,0"
                      IsEnabled="{Binding IsChecked, ElementName=StartCheck}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="SyncTab" Header="{l:Loc Scheduler_TabSync}"
               Visibility="{Binding IsSyncQueue, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
        <StackPanel Margin="10,8">
          <TextBlock Text="{l:Loc Scheduler_SyncIntro}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <WrapPanel>
            <Label Content="{l:Loc Scheduler_SyncEvery}" Target="{Binding ElementName=SyncBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
            <TextBox x:Name="SyncBox" Style="{StaticResource NumberBox}" Text="{Binding SyncIntervalMinutes, ValidatesOnExceptions=True}" />
            <TextBlock Text="{l:Loc Scheduler_Minutes}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </WrapPanel>
          <CheckBox Content="{l:Loc Scheduler_SyncAtStartup}" IsChecked="{Binding SyncAtStartup}" Margin="0,8,0,3" />
          <CheckBox Content="{l:Loc Scheduler_SyncBackup}" IsChecked="{Binding SyncKeepBackup}" />
          <DockPanel Margin="0,8,0,0">
            <Label Content="{l:Loc Scheduler_Retries}" Target="{Binding ElementName=SyncRetriesBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
            <TextBox x:Name="SyncRetriesBox" Style="{StaticResource NumberBox}" HorizontalAlignment="Left" Text="{Binding RetriesPerFile, ValidatesOnExceptions=True}" />
          </DockPanel>
        </StackPanel>
      </TabItem>

      <TabItem x:Name="FilesTab" Header="{l:Loc Scheduler_TabFiles}" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
        <DockPanel Margin="10,8">
          <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{l:Loc Cmd_DeleteFromQueue}" Padding="8,2" Command="{Binding DeleteFromQueueCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Text="{l:Loc Scheduler_SameTimePrefix}" VerticalAlignment="Center" />
              <TextBox Style="{StaticResource NumberBox}" Width="40" Margin="6,0,0,0" Text="{Binding SelectedQueue.SimultaneousCount, ValidatesOnExceptions=True}"
                       AutomationProperties.Name="{l:Loc Scheduler_SameTimePrefix}" />
              <StackPanel Margin="2,0,6,0">
                <RepeatButton Content="▲" FontSize="7" Width="16" Height="11" Padding="0" Command="{Binding MoreAtOnceCommand}" AutomationProperties.Name="+" />
                <RepeatButton Content="▼" FontSize="7" Width="16" Height="11" Padding="0" Command="{Binding FewerAtOnceCommand}" AutomationProperties.Name="-" />
              </StackPanel>
              <TextBlock Text="{l:Loc Scheduler_SameTimeSuffix}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
          <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
            <Button Content="▲" Width="30" Height="26" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{l:Loc Common_MoveUp}" ToolTip="{l:Loc Common_MoveUp}" />
            <Button Content="▼" Width="30" Height="26" Margin="0,6,0,0" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{l:Loc Common_MoveDown}"
                    ToolTip="{l:Loc Common_MoveDown}" />
          </StackPanel>
          <ListView x:Name="FilesList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" SelectionMode="Single" AllowDrop="True"
                    PreviewMouseLeftButtonDown="OnFilesMouseDown" PreviewMouseMove="OnFilesMouseMove" Drop="OnFilesDrop" DragOver="OnFilesDragOver"
                    AutomationProperties.Name="{l:Loc Scheduler_TabFiles}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{l:Loc Col_FileName}" Width="210">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{l:Loc Col_Size}" DisplayMemberBinding="{Binding SizeText}" Width="80" />
                <GridViewColumn Header="{l:Loc Col_Status}" DisplayMemberBinding="{Binding StatusText}" Width="90" />
                <GridViewColumn Header="{l:Loc Col_TimeLeft}" DisplayMemberBinding="{Binding TimeLeftText}" Width="80" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
