<Window x:Class="NovaGet.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NovaGet.App.ViewModels"
        xmlns:l="clr-namespace:NovaGet.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title, Mode=OneTime}"
        Width="900" Height="560" MinWidth="640" MinHeight="400"
        Icon="pack://application:,,,/Assets/novaget.ico"
        UseLayoutRounding="True"
        AutomationProperties.Name="{Binding Title, Mode=OneTime}">

  <Window.Resources>
    <!-- A toolbar item: icon + label (large: label under a 48 px icon; small: label beside a 24 px icon),
         plus a ▾ part when the item has a drop-down menu. The ItemsControl's Tag is the MainViewModel. -->
    <DataTemplate x:Key="ToolbarItemTemplate" DataType="{x:Type vm:ToolbarItemViewModel}">
      <StackPanel Orientation="Horizontal" Margin="1,0"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
        <Button x:Name="Main" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Command}"
                ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
          <StackPanel x:Name="Layout" Orientation="Vertical" MinWidth="54">
            <Image x:Name="Glyph" Source="{Binding LargeIcon}" Width="48" Height="48" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="Caption" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,2,0,0" />
          </StackPanel>
        </Button>
        <Button x:Name="Arrow" Style="{StaticResource ToolbarButtonStyle}" Padding="1,2" Visibility="Collapsed"
                Content="▾" FontSize="10" Click="OnToolbarDropDown" AutomationProperties.Name="{Binding Label}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasDropDown}" Value="True">
          <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag.LargeToolbar, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
          <Setter TargetName="Glyph" Property="Source" Value="{Binding SmallIcon}" />
          <Setter TargetName="Glyph" Property="Width" Value="24" />
          <Setter TargetName="Glyph" Property="Height" Value="24" />
          <Setter TargetName="Layout" Property="Orientation" Value="Horizontal" />
          <Setter TargetName="Layout" Property="MinWidth" Value="0" />
          <Setter TargetName="Caption" Property="Margin" Value="4,0,2,0" />
          <Setter TargetName="Caption" Property="VerticalAlignment" Value="Center" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag.ShowToolbarLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
          <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Layout" Property="MinWidth" Value="0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddUrlCommand}" />
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FindCommand}" />
    <KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
    <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding MoveRenameCommand}" />
    <KeyBinding Key="Return" Modifiers="Alt" Command="{Binding PropertiesCommand}" />
    <KeyBinding Key="F1" Command="{Binding HelpContentsCommand}" />
    <KeyBinding Key="F4" Modifiers="Alt" Command="{Binding ExitCommand}" />
  </Window.InputBindings>

  <DockPanel>
    <!-- ============================== Menu bar ============================== -->
    <Menu DockPanel.Dock="Top" AutomationProperties.Name="Menu">
      <MenuItem Header="{l:Loc Menu_Tasks}">
        <MenuItem Header="{l:Loc Cmd_AddNewDownload}" InputGestureText="Ctrl+N" Command="{Binding AddUrlCommand}" />
        <MenuItem Header="{l:Loc Cmd_AddBatch}" Command="{Binding AddBatchCommand}" />
        <MenuItem Header="{l:Loc Cmd_AddBatchClipboard}" Command="{Binding AddBatchFromClipboardCommand}" />
        <MenuItem Header="{l:Loc Menu_Export}">
          <MenuItem Header="{l:Loc Cmd_ExportEf2}" Command="{Binding ExportCommand}">
            <MenuItem.CommandParameter><x:Static Member="vm:BoolBox.True" /></MenuItem.CommandParameter>
          </MenuItem>
          <MenuItem Header="{l:Loc Cmd_ExportText}" Command="{Binding ExportCommand}">
            <MenuItem.CommandParameter><x:Static Member="vm:BoolBox.False" /></MenuItem.CommandParameter>
          </MenuItem>
        </MenuItem>
        <MenuItem Header="{l:Loc Menu_Import}">
          <MenuItem Header="{l:Loc Cmd_ImportEf2}" Command="{Binding ImportCommand}">
            <MenuItem.CommandParameter><x:Static Member="vm:BoolBox.True" /></MenuItem.CommandParameter>
          </MenuItem>
          <MenuItem Header="{l:Loc Cmd_ImportText}" Command="{Binding ImportCommand}">
            <MenuItem.CommandParameter><x:Static Member="vm:BoolBox.False" /></MenuItem.CommandParameter>
          </MenuItem>
        </MenuItem>
        <Separator />
        <MenuItem Header="{l:Loc Cmd_RunGrabber}" Command="{Binding GrabberCommand}" />
        <MenuItem Header="{l:Loc Cmd_GrabberProjects}" Command="{Binding GrabberProjectsCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_Exit}" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
      </MenuItem>

      <MenuItem Header="{l:Loc Menu_File}">
        <MenuItem Header="{l:Loc Cmd_DownloadNow}" Command="{Binding ResumeCommand}" />
        <MenuItem Header="{l:Loc Cmd_StopDownload}" Command="{Binding StopCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_Remove}" InputGestureText="Del" Command="{Binding DeleteCommand}" />
        <MenuItem Header="{l:Loc Cmd_Redownload}" Command="{Binding RedownloadCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_MoveUp}" Command="{Binding MoveUpCommand}" />
        <MenuItem Header="{l:Loc Cmd_MoveDown}" Command="{Binding MoveDownCommand}" />
        <MenuItem Header="{l:Loc Cmd_Open}" InputGestureText="Enter" Command="{Binding OpenCommand}" />
        <MenuItem Header="{l:Loc Cmd_OpenWith}" Command="{Binding OpenWithCommand}" />
        <MenuItem Header="{l:Loc Cmd_OpenFolder}" Command="{Binding OpenFolderCommand}" />
        <MenuItem Header="{l:Loc Cmd_MoveRename}" InputGestureText="Ctrl+M" Command="{Binding MoveRenameCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_Properties}" InputGestureText="Alt+Enter" Command="{Binding PropertiesCommand}" />
      </MenuItem>

      <MenuItem Header="{l:Loc Menu_Downloads}">
        <MenuItem Header="{l:Loc Cmd_PauseAll}" Command="{Binding PauseAllCommand}" />
        <MenuItem Header="{l:Loc Cmd_StopAll}" Command="{Binding StopAllCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_DeleteAllCompleted}" Command="{Binding DeleteCompletedCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_Find}" InputGestureText="Ctrl+F" Command="{Binding FindCommand}" />
        <MenuItem Header="{l:Loc Cmd_FindNext}" InputGestureText="F3" Command="{Binding FindNextCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_Scheduler}" Command="{Binding SchedulerCommand}" />
        <MenuItem Header="{l:Loc Menu_StartQueue}" ItemsSource="{Binding StartQueueMenu}" ItemContainerStyle="{StaticResource EntryMenuItemStyle}" />
        <MenuItem Header="{l:Loc Menu_StopQueue}" ItemsSource="{Binding StopQueueMenu}" ItemContainerStyle="{StaticResource EntryMenuItemStyle}" />
        <Separator />
        <MenuItem Header="{l:Loc Menu_SpeedLimiter}">
          <MenuItem Header="{l:Loc Cmd_TurnOn}" Command="{Binding LimiterOnCommand}" IsChecked="{Binding IsLimiterOn, Mode=OneWay}" />
          <MenuItem Header="{l:Loc Cmd_TurnOff}" Command="{Binding LimiterOffCommand}" />
          <Separator />
          <MenuItem Header="{l:Loc Cmd_LimiterSettings}" Command="{Binding LimiterSettingsCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{l:Loc Cmd_Options}" Command="{Binding OptionsCommand}" />
      </MenuItem>

      <MenuItem Header="{l:Loc Menu_View}">
        <MenuItem Header="{l:Loc Cmd_HideCategories}" IsCheckable="True" IsChecked="{Binding HideCategories}" />
        <MenuItem Header="{l:Loc Menu_Toolbar}">
          <MenuItem Header="{l:Loc Cmd_LargeButtons}" IsCheckable="True" IsChecked="{Binding LargeToolbar}" />
          <MenuItem Header="{l:Loc Cmd_SmallButtons}" IsCheckable="True" IsChecked="{Binding SmallToolbar}" />
          <MenuItem Header="{l:Loc Cmd_HideLabels}" IsCheckable="True" IsChecked="{Binding HideToolbarLabels}" />
          <Separator />
          <MenuItem Header="{l:Loc Cmd_CustomizeToolbar}" Command="{Binding CustomizeToolbarCommand}" />
          <MenuItem Header="{l:Loc Menu_ToolbarTheme}">
            <MenuItem Header="{l:Loc Theme_Default}" IsChecked="True" />
          </MenuItem>
        </MenuItem>
        <MenuItem x:Name="ArrangeMenu" Header="{l:Loc Menu_Arrange}" />
        <MenuItem Header="{l:Loc Cmd_ShowColumns}" Command="{Binding ShowColumnsCommand}" />
        <MenuItem x:Name="LanguageMenu" Header="{l:Loc Menu_Language}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_ShowDropTarget}" Command="{Binding ToggleDropTargetCommand}" IsChecked="{Binding ShowDropTarget, Mode=OneWay}" />
        <MenuItem Header="{l:Loc Cmd_ShowTrayGraph}" IsCheckable="True" IsChecked="{Binding ShowTraySpeedGraph}" />
      </MenuItem>

      <MenuItem Header="{l:Loc Menu_Help}">
        <MenuItem Header="{l:Loc Cmd_HelpContents}" InputGestureText="F1" Command="{Binding HelpContentsCommand}" />
        <MenuItem Header="{l:Loc Cmd_Faq}" Command="{Binding FaqCommand}" />
        <MenuItem Header="{l:Loc Cmd_CheckUpdates}" Command="{Binding CheckUpdatesCommand}" />
        <Separator />
        <MenuItem Header="{l:Loc Cmd_About}" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- ============================== Toolbar ============================== -->
    <Border DockPanel.Dock="Top" BorderThickness="0,1,0,1" Padding="4,3"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <ItemsControl x:Name="ToolbarItems" ItemsSource="{Binding Toolbar}" Tag="{Binding}"
                    ItemTemplate="{StaticResource ToolbarItemTemplate}" Focusable="False"
                    AutomationProperties.Name="Toolbar">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>

    <!-- ============================== Status bar ============================== -->
    <StatusBar DockPanel.Dock="Bottom" AutomationProperties.Name="Status">
      <StatusBarItem Content="{Binding StatusDownloads}" />
      <Separator />
      <StatusBarItem Content="{Binding StatusActive}" />
      <Separator />
      <StatusBarItem Content="{Binding StatusSpeed}" MinWidth="70" />
      <Separator />
      <StatusBarItem>
        <Button Style="{StaticResource StatusLinkStyle}" Content="{Binding StatusLimiter}"
                Command="{Binding ToggleLimiterCommand}" ToolTip="{l:Loc StatusBar_LimiterTip}" />
      </StatusBarItem>
    </StatusBar>

    <!-- ============================== Categories | list ============================== -->
    <Grid x:Name="BodyGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="CategoriesColumn" Width="190" MinWidth="0" />
        <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="200" />
      </Grid.ColumnDefinitions>

      <DockPanel x:Name="CategoriesPane">
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Content="✕" Padding="5,0"
                  Command="{Binding ToggleCategoriesCommand}" ToolTip="{l:Loc Tree_Close}"
                  AutomationProperties.Name="{l:Loc Tree_Close}" />
          <TextBlock Text="{l:Loc Tree_Categories}" Margin="6,3" VerticalAlignment="Center" />
        </DockPanel>
        <TreeView x:Name="CategoryTree" ItemsSource="{Binding Tree}" BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                  AllowDrop="True" AutomationProperties.Name="{l:Loc Tree_Categories}"
                  SelectedItemChanged="OnTreeSelectionChanged"
                  PreviewMouseRightButtonDown="OnTreeRightButtonDown"
                  ContextMenuOpening="OnTreeContextMenuOpening"
                  DragOver="OnTreeDragOver" Drop="OnTreeDrop">
          <TreeView.ContextMenu>
            <ContextMenu />
          </TreeView.ContextMenu>
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Margin="0,1">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Focusable="False" />

      <DataGrid x:Name="DownloadList" Grid.Column="2" ItemsSource="{Binding ItemsView}"
                AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="21"
                CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                EnableRowVirtualization="True" EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Item" ScrollViewer.IsDeferredScrollingEnabled="False"
                RowStyle="{StaticResource DownloadRowStyle}" CellStyle="{StaticResource DownloadCellStyle}"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                AllowDrop="True" AutomationProperties.Name="Downloads"
                Sorting="OnSorting" SelectionChanged="OnSelectionChanged"
                MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown" PreviewTextInput="OnListTextInput"
                PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                PreviewMouseRightButtonUp="OnListRightButtonUp" DragOver="OnListDragOver" Drop="OnListDrop">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:Loc Cmd_Open}" Command="{Binding OpenCommand}" FontWeight="Bold" />
            <MenuItem Header="{l:Loc Cmd_OpenWith}" Command="{Binding OpenWithCommand}" />
            <MenuItem Header="{l:Loc Cmd_OpenFolder}" Command="{Binding OpenFolderCommand}" />
            <Separator />
            <MenuItem Header="{l:Loc Cmd_MoveRename}" Command="{Binding MoveRenameCommand}" />
            <MenuItem Header="{l:Loc Cmd_Redownload}" Command="{Binding RedownloadCommand}" />
            <MenuItem Header="{l:Loc Cmd_ResumeDownload}" Command="{Binding ResumeCommand}" />
            <MenuItem Header="{l:Loc Cmd_StopDownload}" Command="{Binding StopCommand}" />
            <MenuItem Header="{l:Loc Cmd_RefreshAddress}" Command="{Binding RefreshAddressCommand}" />
            <Separator />
            <MenuItem Header="{l:Loc Cmd_Remove}" Command="{Binding DeleteCommand}" />
            <MenuItem Header="{l:Loc Cmd_RemoveWithFile}" Command="{Binding DeleteWithFileCommand}" />
            <Separator />
            <MenuItem Header="{l:Loc Menu_AddToQueue}" ItemsSource="{Binding AddToQueueMenu}" ItemContainerStyle="{StaticResource EntryMenuItemStyle}" />
            <MenuItem Header="{l:Loc Cmd_DeleteFromQueue}" Command="{Binding DeleteFromQueueCommand}" />
            <Separator />
            <MenuItem Header="{l:Loc Cmd_CopyAddress}" Command="{Binding CopyAddressCommand}" />
            <MenuItem Header="{l:Loc Cmd_Properties}" Command="{Binding PropertiesCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn x:Name="ColFileName" Header="{l:Loc Col_FileName}" Width="250" SortMemberPath="FileName">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                <StackPanel Orientation="Horizontal">
                  <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" />
                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn x:Name="ColQueue" Header="{l:Loc Col_Queue}" Width="28" Binding="{Binding QueuePosition}"
                              SortMemberPath="QueuePosition" ElementStyle="{StaticResource RightAlignedText}" />
          <DataGridTextColumn x:Name="ColSize" Header="{l:Loc Col_Size}" Width="80" Binding="{Binding SizeText}"
                              SortMemberPath="Size" ElementStyle="{StaticResource RightAlignedText}" />
          <DataGridTextColumn x:Name="ColStatus" Header="{l:Loc Col_Status}" Width="90" Binding="{Binding StatusText}"
                              SortMemberPath="StatusRank" ElementStyle="{StaticResource TrimmedText}" />
          <DataGridTextColumn x:Name="ColTimeLeft" Header="{l:Loc Col_TimeLeft}" Width="75" Binding="{Binding TimeLeftText}"
                              SortMemberPath="TimeLeftSeconds" ElementStyle="{StaticResource TrimmedText}" />
          <DataGridTextColumn x:Name="ColRate" Header="{l:Loc Col_TransferRate}" Width="90" Binding="{Binding RateText}"
                              SortMemberPath="Rate" ElementStyle="{StaticResource TrimmedText}" />
          <DataGridTextColumn x:Name="ColLastTry" Header="{l:Loc Col_LastTry}" Width="100" Binding="{Binding LastTryText}"
                              SortMemberPath="LastTry" ElementStyle="{StaticResource TrimmedText}" />
          <DataGridTextColumn x:Name="ColDescription" Header="{l:Loc Col_Description}" Width="150" Binding="{Binding Description}"
                              SortMemberPath="Description" ElementStyle="{StaticResource TrimmedText}" />
          <DataGridTextColumn x:Name="ColSaveTo" Header="{l:Loc Col_SaveTo}" Width="160" Binding="{Binding SaveTo}"
                              SortMemberPath="SaveTo" ElementStyle="{StaticResource TrimmedText}" Visibility="Collapsed" />
          <DataGridTextColumn x:Name="ColReferrer" Header="{l:Loc Col_Referrer}" Width="160" Binding="{Binding Referrer}"
                              SortMemberPath="Referrer" ElementStyle="{StaticResource TrimmedText}" Visibility="Collapsed" />
          <DataGridTextColumn x:Name="ColAdded" Header="{l:Loc Col_Added}" Width="100" Binding="{Binding AddedText}"
                              SortMemberPath="AddedAt" ElementStyle="{StaticResource TrimmedText}" Visibility="Collapsed" />
          <DataGridTextColumn x:Name="ColConnections" Header="{l:Loc Col_Connections}" Width="70" Binding="{Binding ConnectionsText}"
                              SortMemberPath="Connections" ElementStyle="{StaticResource RightAlignedText}" Visibility="Collapsed" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
