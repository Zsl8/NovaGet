<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NovaGet.NativeHost</AssemblyName>
    <RootNamespace>NovaGet.NativeHost</RootNamespace>
    <ApplicationIcon>..\..\assets\icons\ico\novaget.ico</ApplicationIcon>
    <AssemblyTitle>NovaGet browser integration host</AssemblyTitle>
    <Description>Native messaging host that connects the NovaGet browser extension to the NovaGet app.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- The host is trimmed (it uses only the pipe and the framing code; its JSON is source-generated): 40 MB → 19 MB.
       The bundle is not compressed: the installer's LZMA2 compresses the plain files far better. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaGet.Core\NovaGet.Core.csproj" />
  </ItemGroup>

</Project>
