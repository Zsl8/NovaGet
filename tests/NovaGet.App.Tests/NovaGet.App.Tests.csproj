<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF smoke tests: open the real windows against a temp profile. Windows only (CI runs them);
       elsewhere the project still builds but is not treated as a test project. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(OS)' == 'Windows_NT'">true</IsTestProject>
    <IsTestProject Condition="'$(OS)' != 'Windows_NT'">false</IsTestProject>
    <RootNamespace>NovaGet.App.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1861;CA5394;CA1001;CA2000;CA1063;CA1816</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NovaGet.App\NovaGet.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
