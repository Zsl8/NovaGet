<Project Sdk="Microsoft.NET.Sdk">

  <!-- FlaUI (UI Automation) smoke tests: start the real NovaGet.exe in portable mode and drive it like a user or a
       screen reader would. Windows only (CI runs them); elsewhere the project builds but is not a test project. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(OS)' == 'Windows_NT'">true</IsTestProject>
    <IsTestProject Condition="'$(OS)' != 'Windows_NT'">false</IsTestProject>
    <RootNamespace>NovaGet.UiTests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA2201;CA1861;CA5394;CA1001;CA2000;CA1063;CA1816</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first; the tests start its output (they don't load it). -->
    <ProjectReference Include="..\..\src\NovaGet.App\NovaGet.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
